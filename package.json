{
  "name": "dsh-loom",
  "version": "0.1.1",
  "description": "Persistent work coordination for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bootstrap": "./lib/bootstrap.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.3-alpha.2",
    "@shikijs/langs": "^4.6.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "3.4.18",
    "esbuild": "0.28.2",
    "immer": "11.2.10",
    "jsdom": "28.1.0",
    "katex": "^0.18.10",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-test-renderer": "19.2.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.31.0",
    "zustand": "5.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-format": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2"
  }
}
